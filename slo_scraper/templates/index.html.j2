<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>SLO Events</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #f6f1e7; --surface: #fffdf8; --ink: #1f2a2e; --muted: #5d6b70;
  --line: #e3dccb; --accent: #0f766e; --accent-ink: #ffffff; --warn: #b45309;
  --warn-bg: #fef3c7; --stale: #b91c1c; --chip: #ece5d3; --shadow: 0 1px 2px rgba(31,42,46,.08);
  --font: Inter, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  --display: "Bricolage Grotesque", Inter, system-ui, sans-serif;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #12191b; --surface: #1b2528; --ink: #ece7da; --muted: #9db0b4;
    --line: #2b3a3e; --accent: #4fd1c0; --accent-ink: #08201d; --warn: #fbbf24;
    --warn-bg: #3a2c0a; --stale: #f87171; --chip: #243034; --shadow: none;
  }
}
* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body { margin: 0; background: var(--bg); color: var(--ink); font: 16px/1.45 var(--font); overflow-x: hidden; }
.wrap { max-width: 720px; margin: 0 auto; padding: 0 16px 48px; }
header { padding: 20px 0 8px; }
h1 { font: 700 2rem/1.1 var(--display); margin: 0; letter-spacing: -.02em; }
.meta { color: var(--muted); font-size: .9rem; margin-top: 4px; }
.meta .stale { color: var(--stale); font-weight: 600; }
.filters { position: sticky; top: 0; z-index: 20; background: var(--bg); padding: 8px 0; border-bottom: 1px solid var(--line); }
.chips { display: flex; gap: 6px; overflow-x: auto; padding: 3px 0; scrollbar-width: none; }
.chips::-webkit-scrollbar { display: none; }
.chip { flex: none; border: 1px solid var(--line); background: var(--chip); color: var(--ink); font: 500 .85rem var(--font);
  padding: 7px 12px; border-radius: 999px; cursor: pointer; min-height: 36px; }
.chip[aria-pressed="true"] { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
section { margin-top: 24px; }
section > h2, summary h2 { font: 700 1.35rem var(--display); margin: 0 0 4px; letter-spacing: -.01em; }
summary { cursor: pointer; list-style: none; }
summary::-webkit-details-marker { display: none; }
summary h2::after { content: " +"; color: var(--muted); }
details[open] summary h2::after { content: " \2212"; }
.count { color: var(--muted); font: 500 .9rem var(--font); }
.day h3 { position: sticky; top: var(--fh, 96px); z-index: 10; background: var(--bg); margin: 0; padding: 8px 0 5px;
  font: 600 .75rem var(--font); text-transform: uppercase; letter-spacing: .08em; color: var(--accent); }
.card { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 9px 10px; margin: 0 0 6px;
  box-shadow: var(--shadow); display: flex; gap: 10px; align-items: flex-start; }
.card .body { flex: 1; min-width: 0; }
.card h4 { font: 600 1rem/1.2 var(--display); margin: 0; overflow-wrap: anywhere; display: -webkit-box;
  -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.line { font-size: .82rem; color: var(--muted); margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.line.where { color: var(--ink); }
.dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--c, var(--accent)); margin-right: 4px; }
.cat { font-weight: 600; color: var(--ink); }
.badge { display: inline-block; font: 600 .65rem var(--font); padding: 1px 6px; border-radius: 999px; background: var(--warn-bg);
  color: var(--warn); margin-left: 4px; }
.links { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 6px; }
.links a { color: var(--accent); text-decoration: none; font: 600 .75rem var(--font); padding: 4px 9px; min-height: 28px;
  display: inline-flex; align-items: center; border: 1px solid var(--line); border-radius: 999px; background: var(--chip); }
.links a.cal { color: var(--ink); }
.thumb { flex: none; display: block; }
.thumb img { width: 72px; height: 72px; object-fit: cover; border-radius: 8px; background: var(--chip); display: block; }
.wk { margin: 8px 0; }
.wk > summary { font: 600 .9rem var(--font); padding: 8px 0; border-top: 1px solid var(--line); color: var(--accent); }
.wk > summary::after { content: " +"; }
.wk[open] > summary::after { content: " 2"; }
.cat-music { --c: #e11d48; } .cat-art { --c: #7c3aed; } .cat-festival_market { --c: #ea580c; }
.cat-comedy { --c: #ca8a04; } .cat-film_theater { --c: #2563eb; } .cat-food_drink { --c: #16a34a; }
.cat-outdoor { --c: #0d9488; } .cat-community { --c: #db2777; } .cat-other { --c: #6b7280; }
.empty { color: var(--muted); padding: 12px 0; }
.hidden { display: none !important; }
footer { margin-top: 40px; color: var(--muted); font-size: .85rem; }
footer h2 { font: 600 1rem var(--display); color: var(--ink); }
table { border-collapse: collapse; width: 100%; }
th, td { text-align: left; padding: 5px 6px 5px 0; border-bottom: 1px solid var(--line); vertical-align: top; overflow-wrap: anywhere; }
td.err { color: var(--stale); }
</style>
</head>
<body>
<div class="wrap">
<header>
  <h1>SLO Events</h1>
  <div class="meta"><span id="updated" data-iso="{{ generated_iso }}">Updated {{ generated_iso }}</span> &middot; <span id="count">{{ total }}</span> of {{ total }} events</div>
</header>

<div class="filters" id="filters">
  <div class="chips" data-group="cat" aria-label="Category">
    <button class="chip" data-v="" aria-pressed="true">All</button>
    {% for key, label in categories %}<button class="chip" data-v="{{ key }}" aria-pressed="false">{{ label }}</button>{% endfor %}
  </div>
  <div class="chips" data-group="town" aria-label="Town">
    <button class="chip" data-v="" aria-pressed="true">All towns</button>
    {% for t in towns %}<button class="chip" data-v="{{ t }}" aria-pressed="false">{{ t }}</button>{% endfor %}
  </div>
</div>

<main>
{% macro card(c) %}
<article class="card cat-{{ c.category }}" data-cat="{{ c.category }}" data-town="{{ c.town }}">
  <div class="body">
    <h4>{{ c.title }}</h4>
    {% set meta = [c.date_range, c.time, c.price, c.age_limit] | select | list %}
    <div class="line"><span class="dot"></span><span class="cat">{{ c.category_label }}</span>{% if meta %} &middot; {{ meta | join(" &middot; " | safe) }}{% endif %}{% if c.low_confidence %}<span class="badge" title="Details were read from a flyer or post and may be off">check flyer</span>{% endif %}</div>
    {% if c.performers %}<div class="line">{{ c.performers }}</div>{% endif %}
    {% if c.venue or c.town %}<div class="line where">{{ [c.venue, c.town] | select | join(", ") }}</div>{% endif %}
    <div class="links">
      {% for l in c.links[:2] %}<a href="{{ l.url }}" rel="noopener">{{ l.label }}</a>{% endfor %}
      {% if c.ticket_url %}<a href="{{ c.ticket_url }}" rel="noopener">Tickets</a>{% endif %}
      <a class="cal" href="{{ c.cal_url }}" rel="noopener" target="_blank" title="Add to Google Calendar" aria-label="Add to Google Calendar">+ Cal</a>
    </div>
  </div>
  {% if c.flyer %}<a class="thumb" href="{{ c.flyer }}" target="_blank" rel="noopener"><img src="{{ c.flyer }}" loading="lazy" alt="Flyer for {{ c.title }}" width="72" height="72"></a>{% endif %}
</article>
{% endmacro %}
{% macro days(ds) %}{% for d in ds %}<div class="day"><h3>{{ d.label }}</h3>{% for c in d.cards %}{{ card(c) }}{% endfor %}</div>{% endfor %}{% endmacro %}

{% for s in sections if s.count %}
{% if s.collapsed %}
<section data-section="{{ s.key }}"><details>
  <summary><h2 style="display:inline">{{ s.title }}</h2> <span class="count">{{ s.count }}</span></summary>
{% else %}
<section data-section="{{ s.key }}">
  <h2>{{ s.title }} <span class="count">{{ s.count }}</span></h2>
{% endif %}
  {{ days(s.days) }}
  {% for w in s.weeks %}<details class="wk"><summary>{{ w.label }} <span class="count">{{ w.count }}</span></summary>{{ days(w.days) }}</details>{% endfor %}
{% if s.collapsed %}</details></section>{% else %}</section>{% endif %}
{% endfor %}
<p class="empty hidden" id="none">No events match these filters.</p>
</main>

<footer>
  <h2>Sources</h2>
  {% if stats %}
  <table>
    <tr><th>Source</th><th>Events</th><th>Unique</th><th>Error</th></tr>
    {% for r in stats %}<tr><td>{{ r.source }}</td><td>{{ r.events }}</td><td>{{ r.unique }}</td><td class="{{ 'err' if r.error }}">{{ r.error }}</td></tr>{% endfor %}
  </table>
  {% else %}<p>No source stats.</p>{% endif %}
</footer>
</div>
<script>
(function () {
  var KEY = "slo-filters-v1";
  var sel = { cat: [], town: [] };
  try { var s = JSON.parse(localStorage.getItem(KEY) || "null"); if (s) { sel.cat = s.cat || []; sel.town = s.town || []; } } catch (e) {}

  var up = document.getElementById("updated");
  var t = Date.parse(up.getAttribute("data-iso"));
  if (!isNaN(t)) {
    var h = Math.max(0, Math.floor((Date.now() - t) / 36e5));
    up.textContent = "Updated " + (h < 1 ? "just now" : h === 1 ? "1 hour ago" : h < 48 ? h + " hours ago" : Math.floor(h / 24) + " days ago");
    if (h >= 30) up.className = "stale";
  }

  var cards = Array.prototype.slice.call(document.querySelectorAll(".card"));
  var groups = Array.prototype.slice.call(document.querySelectorAll(".chips"));

  function save() { try { localStorage.setItem(KEY, JSON.stringify(sel)); } catch (e) {} }

  function apply() {
    var shown = 0;
    cards.forEach(function (c) {
      var ok = (!sel.cat.length || sel.cat.indexOf(c.dataset.cat) > -1) &&
               (!sel.town.length || sel.town.indexOf(c.dataset.town) > -1);
      c.classList.toggle("hidden", !ok);
      if (ok) shown++;
    });
    Array.prototype.forEach.call(document.querySelectorAll(".day"), function (d) {
      d.classList.toggle("hidden", !d.querySelector(".card:not(.hidden)"));
    });
    var filtering = sel.cat.length || sel.town.length;
    Array.prototype.forEach.call(document.querySelectorAll("details.wk"), function (w) {
      w.classList.toggle("hidden", !w.querySelector(".card:not(.hidden)"));
      if (filtering) w.open = true;
    });
    Array.prototype.forEach.call(document.querySelectorAll("section[data-section]"), function (s) {
      var any = s.querySelector(".card:not(.hidden)");
      s.classList.toggle("hidden", !any);
    });
    document.getElementById("count").textContent = shown;
    document.getElementById("none").classList.toggle("hidden", shown > 0);
    groups.forEach(function (g) {
      var cur = sel[g.dataset.group];
      Array.prototype.forEach.call(g.children, function (b) {
        var v = b.dataset.v;
        b.setAttribute("aria-pressed", String(v === "" ? cur.length === 0 : cur.indexOf(v) > -1));
      });
    });
  }

  groups.forEach(function (g) {
    var valid = Array.prototype.map.call(g.children, function (b) { return b.dataset.v; });
    sel[g.dataset.group] = sel[g.dataset.group].filter(function (v) { return valid.indexOf(v) > -1; });
    g.addEventListener("click", function (e) {
      var b = e.target.closest(".chip"); if (!b) return;
      var list = sel[g.dataset.group], v = b.dataset.v;
      if (v === "") list.length = 0;
      else { var i = list.indexOf(v); if (i > -1) list.splice(i, 1); else list.push(v); }
      save(); apply();
    });
  });
  function fh() { document.documentElement.style.setProperty("--fh", document.getElementById("filters").offsetHeight + "px"); }
  fh(); window.addEventListener("resize", fh);
  apply();
})();
</script>
</body>
</html>
